{
  "manifest_version": 3,
  "name": "Float Calci",
  "version": "1.3.0",
  "description": "Basic, Scientific and Financial calculators that float over any page, and on top of all your apps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Float Calci: show a floating calculator on this page"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "assets/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Show or hide the floating calculator on this page"
    },
    "open-floating-window": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Open the floating calculator window (can float above all apps)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
