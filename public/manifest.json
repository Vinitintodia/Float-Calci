{
    "manifest_version": 3,
    "name": "Float Calci",
    "version": "1.0.0",
    "description": "A floating calculator extension with Basic, Scientific, and Financial calculators",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Float Calci"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}