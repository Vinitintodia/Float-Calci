{
  "manifest_version": 3,
  "name": "Float Calci",
  "version": "1.1.0",
  "description": "Basic, Scientific and Financial calculators that can float on top of all your apps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Float Calci"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": ["storage", "identity"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open Float Calci"
    },
    "open-floating-window": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the floating calculator window"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
