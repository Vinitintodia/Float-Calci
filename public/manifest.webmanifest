  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    { "src": "/icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/app-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Basic calculator", "url": "/?app&calc=basic", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Scientific calculator", "url": "/?app&calc=scientific", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] },
    { "name": "Financial calculator", "url": "/?app&calc=financial", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192" }] }
  ]
}
