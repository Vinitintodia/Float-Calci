{
  "name": "Float Calci",
  "short_name": "Float Calci",
  "description": "Basic, scientific and financial calculators that float on top of every tab and app.",
  "id": "/?app",
  "start_url": "/?app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f5f5",
